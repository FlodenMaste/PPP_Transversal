# Copier ce fichier en .env et adapter une fois le labo (bloc 1) prêt.
# Tant que COLLECTOR_MODE=simulated, aucune des autres valeurs n'a
# besoin d'être correcte - les collecteurs utilisent les fixtures.

COLLECTOR_MODE=simulated
# COLLECTOR_MODE=real

# SNMP - SNMPv3 authPriv UNIQUEMENT (v1/v2c et community non supportes)
# Valeurs du labo containerlab (cf. lab/containerlab/configs/*/snmpd.conf) -
# a remplacer par les identifiants reels du parc en production.
SNMPV3_USER=mcpreadonly
SNMPV3_AUTH_KEY=AuthPass2026!
SNMPV3_PRIV_KEY=PrivPass2026!
# SHA/SHA256 pour l'authentification, AES/AES256 pour le chiffrement.
# Le labo utilise SHA (createUser des routeurs) ; SHA256 reste la valeur
# par defaut du code pour un parc moderne.
SNMPV3_AUTH_PROTOCOL=SHA
SNMPV3_PRIV_PROTOCOL=AES
SNMP_PORT=161
SNMP_TIMEOUT=2
SNMP_RETRIES=1

# NETCONF (port 830 : aucun agent NETCONF n'est embarque dans le labo FRR ;
# en mode reel cette collecte retourne une erreur explicite)
NETCONF_USERNAME=noc
NETCONF_PASSWORD=LabPass2026!
NETCONF_PORT=830
NETCONF_TIMEOUT=10
# Cles d'hote : a desactiver UNIQUEMENT dans le labo (redeploiement frequent)
# NETCONF_HOSTKEY_VERIFY=false

# CLI (netmiko) - SSH vers les routeurs FRR du labo
CLI_USERNAME=noc
CLI_PASSWORD=LabPass2026!
CLI_DEVICE_TYPE=linux
CLI_VTYSH=true
CLI_TIMEOUT=10

# NetFlow
NFDUMP_BIN=/usr/bin/nfdump
NETFLOW_DATA_DIR=/var/netflow

# PCAP (contraintes de sécurité - ne pas augmenter sans raison documentée)
PCAP_MAX_DURATION_SECONDS=30
PCAP_MAX_PACKETS=1000
PCAP_OUTPUT_DIR=/tmp/pcap_captures

# Syslog
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_LISTEN_PORT=514
SYSLOG_FILE_PATH=/var/log/network_syslog.log

# Connectivité (plafonds de sécurité)
PING_MAX_COUNT=5
PING_TIMEOUT_SECONDS=2
TRACEROUTE_MAX_HOPS=20
TRACEROUTE_TIMEOUT_SECONDS=2

# QoS (OIDs SNMP, à adapter à la MIB des équipements)
QOS_PKTS_OID=1.3.6.1.4.1.9.9.166.1.15.1.1.3
QOS_DROPS_OID=1.3.6.1.4.1.9.9.166.1.15.1.1.13

# Détection d'anomalies (seuils déterministes)
ANOMALY_TOP_TALKER_RATIO=0.80
ANOMALY_MIN_AVG_PACKET_BYTES=100
ANOMALY_MIN_PACKETS=1000
ANOMALY_MAX_FLOWS=1000
