# Secrets du laboratoire Containerlab - serveur 2 (outils reseau).
# Copier : cp .env.example .env   puis renseigner les valeurs.
#
# Les valeurs du laboratoire de demonstration sont dans :
#   ../PPP_MCP_Telecom_Supervision/lab/containerlab/topology.clab.yml
#   (comptes mcpreadonly / noc - lecture seule uniquement)
# NE JAMAIS reutiliser ces mots de passe hors du labo.

# SNMPv3 authPriv - compte en lecture seule (vue "limited")
SNMPV3_USER=mcpreadonly
SNMPV3_AUTH_KEY=remplacer_avec_AuthPass_du_labo
SNMPV3_PRIV_KEY=remplacer_avec_PrivPass_du_labo
SNMPV3_AUTH_PROTOCOL=SHA
SNMPV3_PRIV_PROTOCOL=AES

# SSH - compte membre de frrvty (vtysh en lecture seule)
ROUTER_SSH_USER=noc
ROUTER_SSH_PASS=remplacer_avec_LabPass_du_labo
ROUTER_SSH_PORT=22
