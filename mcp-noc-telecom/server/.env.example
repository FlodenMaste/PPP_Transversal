# --- Authentification locale (mode AUTH_MODE=local, hors Keycloak) -------
JWT_SECRET=change-moi-avant-la-demo
JWT_EXPIRATION_MINUTES=60

# --- A.6 : Keycloak (OIDC) + OAuth 2.1 / PKCE ----------------------------
# keycloak (defaut) : jetons verifies via JWKS (RS256) + issuer du realm
AUTH_MODE=keycloak
KEYCLOAK_REALM_URL=http://localhost:18080/realms/mcp-noc
# URL publique du serveur MCP (metadonnees OAuth - RFC 9728)
MCP_BASE_URL=http://localhost:8001

# --- Transport -------------------------------------------------------------
# stdio (demo/tests) ou http (Streamable HTTP, requis pour OAuth 2.1 + PKCE)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001

# --- Consentement humain obligatoire (A.6) --------------------------------
# elicitation (defaut) | terminal | dry_run (tests) | deny
CONSENT_MODE=elicitation

# --- Secrets du laboratoire (B.6) ------------------------------------------
SNMP_USER=mcpreadonly
SNMP_AUTH_PASS=AuthPass2026!
SNMP_PRIV_PASS=PrivPass2026!
